{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackspirits.dev/humanizer-pt-pt/contracts/eval-corpus.schema.json",
  "title": "Humanizer pt-PT eval corpus",
  "type": "object",
  "required": [
    "metadata",
    "cases"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "locale": {
          "type": "string"
        },
        "orthography": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "input"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "AUTO",
              "AUDITAR",
              "HUMANIZAR",
              "QA HUMANO",
              "CLONAR VOZ"
            ]
          },
          "input": {
            "type": "string",
            "minLength": 1
          },
          "voice_sample": {
            "type": "string"
          },
          "must_avoid": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "must_preserve": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "must_preserve_exact": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "must_include_one_of": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "must_not_invent": {
            "type": "array",
            "items": {}
          },
          "manual_checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "max_words": {
            "type": "integer",
            "minimum": 1
          },
          "preferred_output_shape": {
            "type": "string"
          },
          "expected_mode_selection": {
            "enum": [
              "HUMANIZAR",
              "QA HUMANO"
            ]
          },
          "expected_pattern_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "forbidden_pattern_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "expected_overall_severity": {
            "enum": [
              "limpo",
              "ligeiro",
              "moderado",
              "pesado"
            ]
          },
          "must_not_claim_ai_origin": {
            "type": "boolean"
          },
          "preserve_semantic_anchors": {
            "type": "boolean"
          },
          "semantic_anchor_exceptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "max_change_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
